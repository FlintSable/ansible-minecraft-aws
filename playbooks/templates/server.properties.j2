# server.properties — managed by Ansible. Do NOT edit by hand.
# Source of truth: playbooks/site.yml's vars: block

# Network (Part 1 §9)
server-port={{ mc_port }}
enable-query={{ mc_query_enabled | lower }}
query.port={{ mc_query_port }}

# Server identity
motd={{ motd }}

